{
  "schemaVersion": 1,
  "profiles": [
    {
      "id": "sae-j1979-core",
      "displayName": "Standard OBD-II (SAE J1979)",
      "ecuHeaders": {
        "engine": {
          "transmit": "7E0",
          "receive": "7E8"
        }
      },
      "signals": [
        {
          "id": "ambientTemp",
          "label": "Ambient Air Temp",
          "header": "7E0",
          "mode": "01",
          "pid": "46",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "postOffset": -40
          },
          "unit": "degC",
          "minimum": -40,
          "maximum": 215,
          "summary": "Outside air temperature, measured at the front of the car.",
          "category": "vehicle"
        },
        {
          "id": "baro",
          "label": "Barometric Pressure",
          "header": "7E0",
          "mode": "01",
          "pid": "33",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {},
          "unit": "kPa",
          "minimum": 0,
          "maximum": 255,
          "summary": "Atmospheric pressure. Falls with altitude, and is the reference boost is measured against.",
          "category": "air"
        },
        {
          "id": "coolantTemp",
          "label": "Coolant Temp",
          "header": "7E0",
          "mode": "01",
          "pid": "05",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "postOffset": -40
          },
          "unit": "degC",
          "minimum": -40,
          "maximum": 215,
          "redline": 110,
          "summary": "Engine coolant temperature. Sits in a narrow band once warmed up; a steady climb above it is worth stopping for.",
          "category": "engine"
        },
        {
          "id": "engineLoad",
          "label": "Engine Load",
          "header": "7E0",
          "mode": "01",
          "pid": "04",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "factor": 100,
            "divisor": 255
          },
          "unit": "pct",
          "minimum": 0,
          "maximum": 100,
          "summary": "How hard the engine is working, as a percentage of what it could produce at the current speed.",
          "category": "engine"
        },
        {
          "id": "fuelLevel",
          "label": "Fuel Level",
          "header": "7E0",
          "mode": "01",
          "pid": "2F",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "factor": 100,
            "divisor": 255
          },
          "unit": "pct",
          "minimum": 0,
          "maximum": 100,
          "summary": "Fuel remaining in the tank.",
          "category": "fuel"
        },
        {
          "id": "fuelPressure",
          "label": "Fuel Pressure",
          "header": "7E0",
          "mode": "01",
          "pid": "0A",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "factor": 3
          },
          "unit": "kPa",
          "minimum": 0,
          "maximum": 765,
          "summary": "Low-pressure fuel supply, before the high-pressure pump. It reads to 765 kPa and no further, so it clips above that even though the sensor behind it measures to 1,100 kPa. Many direct-injection engines do not report it at all.",
          "category": "fuel"
        },
        {
          "id": "fuelRailPressureDirect",
          "label": "Fuel Rail Pressure",
          "header": "7E0",
          "mode": "01",
          "pid": "23",
          "byteOffset": 0,
          "byteCount": 2,
          "conversion": {
            "factor": 10
          },
          "unit": "kPa",
          "minimum": 0,
          "maximum": 20000,
          "summary": "High-pressure fuel rail, the one direct injection actually runs on. Warm idle sits near 40 bar and full load reaches 200 bar. Watch it after shutdown: a rail that bleeds down while the car sits is a common cause of long cranking on the next start.",
          "category": "fuel"
        },
        {
          "id": "fuelRailPressureRelative",
          "label": "Fuel Pressure (Manifold-Relative)",
          "header": "7E0",
          "mode": "01",
          "pid": "22",
          "byteOffset": 0,
          "byteCount": 2,
          "conversion": {
            "factor": 0.079
          },
          "unit": "kPa",
          "minimum": 0,
          "maximum": 5177,
          "summary": "Pressure measured against manifold vacuum rather than the atmosphere. It tops out near 52 bar, so on a direct-injection engine that runs to 200 bar it cannot show the high-pressure rail. Read it as the low-pressure supply and treat any value pinned at the top as off the scale.",
          "category": "fuel"
        },
        {
          "id": "intakeTemp",
          "label": "Intake Air Temp",
          "header": "7E0",
          "mode": "01",
          "pid": "0F",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "postOffset": -40
          },
          "unit": "degC",
          "minimum": -40,
          "maximum": 215,
          "summary": "Air temperature entering the engine, after the intercooler on a turbocharged car.",
          "category": "air"
        },
        {
          "id": "longTrimB1",
          "label": "Long-Term Fuel Trim",
          "header": "7E0",
          "mode": "01",
          "pid": "07",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "factor": 100,
            "divisor": 128,
            "postOffset": -100
          },
          "unit": "pct",
          "minimum": -100,
          "maximum": 99.2,
          "summary": "The learned fuelling correction the ECU has settled on. Drifting well away from zero points at an air leak, a fuel delivery problem or a tiring sensor.",
          "category": "fuel"
        },
        {
          "id": "maf",
          "label": "Mass Air Flow",
          "header": "7E0",
          "mode": "01",
          "pid": "10",
          "byteOffset": 0,
          "byteCount": 2,
          "conversion": {
            "divisor": 100
          },
          "unit": "gps",
          "minimum": 0,
          "maximum": 655.35,
          "summary": "Mass of air entering the engine. Absent on speed-density engines, which work it out from manifold pressure instead.",
          "category": "air"
        },
        {
          "id": "map",
          "label": "Manifold Pressure",
          "header": "7E0",
          "mode": "01",
          "pid": "0B",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {},
          "unit": "kPa",
          "minimum": 0,
          "maximum": 255,
          "summary": "Absolute pressure in the intake manifold. Below atmospheric under vacuum, above it under boost.",
          "category": "air"
        },
        {
          "id": "moduleVoltage",
          "label": "System Voltage",
          "header": "7E0",
          "mode": "01",
          "pid": "42",
          "byteOffset": 0,
          "byteCount": 2,
          "conversion": {
            "divisor": 1000
          },
          "unit": "V",
          "minimum": 0,
          "maximum": 65.535,
          "summary": "Supply voltage at the engine computer. Around 12 V with the engine off, higher once the alternator is charging.",
          "category": "electrical"
        },
        {
          "id": "rpm",
          "label": "Engine RPM",
          "header": "7E0",
          "mode": "01",
          "pid": "0C",
          "byteOffset": 0,
          "byteCount": 2,
          "conversion": {
            "divisor": 4
          },
          "unit": "rpm",
          "minimum": 0,
          "maximum": 8000,
          "redline": 6500,
          "summary": "Engine speed in revolutions per minute.",
          "category": "engine"
        },
        {
          "id": "runTime",
          "label": "Engine Run Time",
          "header": "7E0",
          "mode": "01",
          "pid": "1F",
          "byteOffset": 0,
          "byteCount": 2,
          "conversion": {},
          "unit": "s",
          "minimum": 0,
          "maximum": 65535,
          "summary": "Time since the engine last started.",
          "category": "engine"
        },
        {
          "id": "shortTrimB1",
          "label": "Short-Term Fuel Trim",
          "header": "7E0",
          "mode": "01",
          "pid": "06",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "factor": 100,
            "divisor": 128,
            "postOffset": -100
          },
          "unit": "pct",
          "minimum": -100,
          "maximum": 99.2,
          "summary": "The ECU's immediate fuelling correction from the oxygen sensor. Swings either side of zero constantly, which is normal.",
          "category": "fuel"
        },
        {
          "id": "speed",
          "label": "Vehicle Speed",
          "header": "7E0",
          "mode": "01",
          "pid": "0D",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {},
          "unit": "kmh",
          "minimum": 0,
          "maximum": 255,
          "summary": "Road speed as the vehicle reports it.",
          "category": "drivetrain"
        },
        {
          "id": "throttle",
          "label": "Throttle Position",
          "header": "7E0",
          "mode": "01",
          "pid": "11",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "factor": 100,
            "divisor": 255
          },
          "unit": "pct",
          "minimum": 0,
          "maximum": 100,
          "summary": "Throttle position, as a percentage of fully open.",
          "category": "air"
        },
        {
          "id": "timingAdvance",
          "label": "Timing Advance",
          "header": "7E0",
          "mode": "01",
          "pid": "0E",
          "byteOffset": 0,
          "byteCount": 1,
          "conversion": {
            "divisor": 2,
            "postOffset": -64
          },
          "unit": "deg",
          "minimum": -64,
          "maximum": 63.5,
          "summary": "Ignition timing ahead of top dead centre. The ECU retards it when it detects knock.",
          "category": "engine"
        }
      ],
